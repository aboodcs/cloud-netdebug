# Copy this file to terraform.tfvars and replace every placeholder.
# terraform.tfvars is ignored because it can contain local access information.

allowed_ssh_cidr   = "REPLACE_WITH_YOUR_PUBLIC_IP/32"
key_name           = "REPLACE_WITH_YOUR_EC2_KEY_PAIR_NAME"
ssh_public_key_path = "/absolute/path/to/your/ssh-public-key.pub"

# Optional overrides:
# aws_region          = "eu-central-1"
# admin_instance_type = "t3.small"
# target_instance_type = "t3.small"
